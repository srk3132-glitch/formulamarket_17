# Twilio API Credentials for Real-time SMS and OTP Verification
# Get these from your Twilio Console: https://console.twilio.com/

TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: If using Twilio Verify Service (starts with VA...)
# TWILIO_VERIFY_SERVICE_SID=VA_YOUR_VERIFY_SERVICE_SID_HERE

# Supabase Realtime Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
