# ==============================================================================
# FORMULA MARKET - ENVIRONMENT CONFIGURATION
# Set these in your local .env.local AND in Vercel Project Settings (Production & Preview)
# ==============================================================================

# Supabase Credentials (Required for Shared Database & Realtime Sync across all devices)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Vite compatibility aliases (auto-supported)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Twilio SMS & OTP Credentials (Optional for production SMS delivery)
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VA_YOUR_VERIFY_SERVICE_SID_HERE
